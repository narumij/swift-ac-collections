+        """For a receipt: the recorded check of the received request against the file (None when no document is named)."""
+        if event != 'received':
+            return {}
+        return {'docCheck': next((r for r in reversed(self._doc_records(con, letter_id)) if r['kind'] == 'receipt'), None)}
