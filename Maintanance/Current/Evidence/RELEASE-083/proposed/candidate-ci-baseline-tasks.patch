@@ -0,0 +1,13 @@
+# Tasks that exist in the candidate but not in the baseline release.
+# They are measured for the candidate only and are not compared.
+# A task missing from the baseline that is not listed here fails the check.
+# Remove entries once the baseline release contains them.
+# Added in 2026-10-12 (b6ff8a85), after 0.5.3.
+ElementBuffer2D<Int> element(at:) sequential read checksum
+ElementBuffer2D<Int> setElement(_:at:) sequential write
+ElementBuffer3D<Int> element(at:) sequential read checksum
+ElementBuffer3D<Int> setElement(_:at:) sequential write
+OptionalElementBuffer2D<Int> direct methods cold memoization checksum
+OptionalElementBuffer2D<Int> direct methods warm memoization checksum
+OptionalElementBuffer3D<Int> direct methods cold memoization checksum
+OptionalElementBuffer3D<Int> direct methods warm memoization checksum
diff -ruN a/Benchmarks/Scripts/filter_library_for_baseline.py b/Benchmarks/Scripts/filter_library_for_baseline.py
--- a/Benchmarks/Scripts/filter_library_for_baseline.py	1970-01-01 09:00:00
+++ b/Benchmarks/Scripts/filter_library_for_baseline.py	2026-10-16 22:40:40
@@ -0,0 +1,23 @@
+#!/usr/bin/env python3
+"""Keep only tasks known to the baseline binary; write the dropped titles. Usage:
+filter_library.py LIBRARY.json KNOWN_TASKS.txt MISSING_OUT.txt"""
+import json, sys
+lib_path, known_path, missing_path = sys.argv[1:4]
+known = set(l.rstrip('\n') for l in open(known_path, encoding='utf-8') if l.strip())
+lib = json.load(open(lib_path, encoding='utf-8'))
+missing = []
+def walk(node):
+    if isinstance(node, dict):
+        if 'tasks' in node:
+            missing.extend(t for t in node['tasks'] if t not in known)
+            node['tasks'] = [t for t in node['tasks'] if t in known]
+        node['contents'] = [c for c in (walk(c) for c in node.get('contents', [])) if c is not None] if 'contents' in node else node.get('contents')
+        if node.get('contents') is None: node.pop('contents', None)
+        if node.get('kind') == 'chart' and not node.get('tasks'): return None
+        if node.get('kind') == 'group' and not node.get('contents'): return None
+    return node
+lib = walk(lib) or {"kind": "group", "title": "empty", "contents": []}
+json.dump(lib, open(lib_path, 'w', encoding='utf-8'), ensure_ascii=False, indent=2)
+open(missing_path, 'a', encoding='utf-8').write(''.join(t + '\n' for t in missing))
+print(f'{len(missing)} task(s) not in baseline, excluded from baseline run')
+for t in missing: print('  ' + t)
